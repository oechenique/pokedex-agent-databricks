# Copiar a .env (gitignoreado) y completar. No commitear valores reales de
# ANTHROPIC_API_KEY -- reglas/05-guardrails-seguridad.md.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# URL de la Databricks App pokedex-mcp-server -- `databricks apps get
# pokedex-mcp-server --profile <perfil>` -> campo "url". No es secreto (hace
# falta OAuth para pegarle igual), pero es específico de este workspace.
MCP_SERVER_URL=https://pokedex-mcp-server-7405616363788532.12.azure.databricksapps.com

# Perfil de `databricks auth login` (~/.databrickscfg) que apunta al mismo
# workspace de arriba. Vacío = perfil DEFAULT.
DATABRICKS_PROFILE=adb-7405616363788532
